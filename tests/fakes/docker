#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${STACK_DOCKER_LOG:-}" ]]; then
  {
    printf 'docker'
    printf ' %q' "$@"
    printf '\n'
  } >>"$STACK_DOCKER_LOG"
fi

joined=" $* "
arguments=("$@")
last_argument=${arguments[$((${#arguments[@]} - 1))]:-}
if [[ "$1" == --fail ]]; then
  request_body=
  if [[ "$joined" == *" --data-binary @- "* ]]; then
    request_body=$(cat)
    if [[ -n "${STACK_FAKE_HTTP_BODY_LOG:-}" ]]; then
      printf '%s\n' "$request_body" >>"$STACK_FAKE_HTTP_BODY_LOG"
    fi
  fi
  if [[ -n "${STACK_FAKE_FAIL_HTTP_URL:-}" && "$last_argument" == "$STACK_FAKE_FAIL_HTTP_URL" ]]; then
    exit 46
  fi
  case "$last_argument" in
    http://127.0.0.1:11440/api/generate)
      [[ "${STACK_FAKE_FAIL_OLLAMA_REQUEST:-}" != generate ]] || exit 48
      if [[ -n "${STACK_FAKE_GENERATE_RESPONSE+x}" ]]; then
        printf '%s\n' "$STACK_FAKE_GENERATE_RESPONSE"
      else
        printf '%s\n' '{"model":"gemma4:e4b","response":"generated-health-secret","done":true}'
      fi
      ;;
    http://127.0.0.1:11441/api/embed)
      [[ "${STACK_FAKE_FAIL_OLLAMA_REQUEST:-}" != embed ]] || exit 49
      if [[ -n "${STACK_FAKE_EMBED_RESPONSE+x}" ]]; then
        printf '%s\n' "$STACK_FAKE_EMBED_RESPONSE"
      else
        printf '%s\n' '{"model":"embeddinggemma:300m","embeddings":[[0.125]]}'
      fi
      ;;
    http://127.0.0.1:11440/api/ps)
      if [[ -n "${STACK_FAKE_LLM_PS_RESPONSE+x}" ]]; then
        printf '%s\n' "$STACK_FAKE_LLM_PS_RESPONSE"
      else
        printf '%s\n' '{"models":[{"name":"gemma4:e4b","model":"gemma4:e4b","size":1024,"size_vram":1024}]}'
      fi
      ;;
    http://127.0.0.1:11441/api/ps)
      if [[ -n "${STACK_FAKE_EMBEDDING_PS_RESPONSE+x}" ]]; then
        printf '%s\n' "$STACK_FAKE_EMBEDDING_PS_RESPONSE"
      else
        printf '%s\n' '{"models":[{"name":"embeddinggemma:300m","model":"embeddinggemma:300m","size":256,"size_vram":256}]}'
      fi
      ;;
  esac
  exit 0
fi
if (($# == 8)) && [[ "$1" == run && "$2" == --rm && "$3" == --gpus && "$4" == all && "$6" == nvidia-smi && "$7" == --query-gpu=name && "$8" == --format=csv,noheader ]]; then
  [[ "${STACK_FAKE_CONTAINER_GPU_STATUS:-0}" == 0 ]] || exit "$STACK_FAKE_CONTAINER_GPU_STATUS"
  printf '%s\n' "${STACK_FAKE_CONTAINER_GPU_NAMES-NVIDIA T4}"
  exit 0
fi
if (($# == 4)) && [[ "$1" == inspect && "$2" == --format && "$3" == '{{json .HostConfig.DeviceRequests}}' ]]; then
  case "$4" in
    container-ollama-llm)
      if [[ -n "${STACK_FAKE_DEVICE_REQUEST_OLLAMA_LLM+x}" ]]; then
        printf '%s\n' "$STACK_FAKE_DEVICE_REQUEST_OLLAMA_LLM"
      else
        printf '%s\n' '[{"Driver":"nvidia","Count":-1,"DeviceIDs":null,"Capabilities":[["gpu"]]}]'
      fi
      ;;
    container-ollama-embedding)
      if [[ -n "${STACK_FAKE_DEVICE_REQUEST_OLLAMA_EMBEDDING+x}" ]]; then
        printf '%s\n' "$STACK_FAKE_DEVICE_REQUEST_OLLAMA_EMBEDDING"
      else
        printf '%s\n' '[{"Driver":"nvidia","Count":-1,"DeviceIDs":null,"Capabilities":[["gpu"]]}]'
      fi
      ;;
    *) exit 51 ;;
  esac
  exit 0
fi
if (($# == 3)) && [[ "$1" == info && "$2" == --format && "$3" == '{{.DockerRootDir}}' ]]; then
  [[ -z "${STACK_FAKE_DOCKER_INFO_ERROR:-}" ]] || exit 45
  if [[ -n "${STACK_FAKE_DOCKER_ROOT_DIR+x}" ]]; then
    printf '%s\n' "$STACK_FAKE_DOCKER_ROOT_DIR"
  else
    printf '%s\n' /var/lib/docker
  fi
  exit 0
fi
if [[ -n "${STACK_FAKE_REQUIRE_OPENSEARCH_B64:-}" && "$joined" == *" config "* ]]; then
  [[ -n "${STACK_OPENSEARCH_CONFIG_B64:-}" && -n "${STACK_OPENSEARCH_ENTRYPOINT_B64:-}" ]] || exit 61
fi
project_directory=
compose_file=
versions_file=
if [[ -n "${STACK_FAKE_FAIL_HTTP_URL:-}" && "$1" != compose && "$last_argument" == "$STACK_FAKE_FAIL_HTTP_URL" ]]; then
  exit 46
fi
if [[ -n "${STACK_FAKE_FAIL_DYNAMODB:-}" && "$joined" == *" exec -T dynamodb-admin node -e "* ]]; then
  exit 47
fi
if [[ -n "${STACK_FAKE_FAIL_OLLAMA_SERVICE:-}" && "$joined" == *" exec -T $STACK_FAKE_FAIL_OLLAMA_SERVICE /bin/sh -c "* ]]; then
  exit 48
fi
for ((index = 0; index < ${#arguments[@]}; index++)); do
  if [[ "${arguments[$index]}" == --project-directory && $((index + 1)) -lt ${#arguments[@]} ]]; then
    project_directory=${arguments[$((index + 1))]}
  elif [[ "${arguments[$index]}" == --file && $((index + 1)) -lt ${#arguments[@]} ]]; then
    compose_file=${arguments[$((index + 1))]}
  elif [[ "${arguments[$index]}" == --env-file && -z "$versions_file" && $((index + 1)) -lt ${#arguments[@]} ]]; then
    versions_file=${arguments[$((index + 1))]}
  fi
done
if [[ -n "${STACK_FAKE_RENDER_LOG:-}" && "$joined" == *" config "* ]]; then
  printf '%s\n' "$project_directory" >>"$STACK_FAKE_RENDER_LOG"
fi
if [[ -n "${STACK_FAKE_CONTENT_LOG:-}" && "$joined" == *" config "* ]]; then
  config_source=$project_directory/config/opensearch/opensearch.yml
  wrapper_source=$project_directory/config/opensearch/docker-entrypoint.sh
  {
    printf 'compose.yaml '
    sha256sum -- "$compose_file" | awk '{ print $1 }'
    printf 'versions.env '
    sha256sum -- "$versions_file" | awk '{ print $1 }'
    printf 'config/opensearch/opensearch.yml '
    if [[ -n "${STACK_OPENSEARCH_CONFIG_B64:-}" ]]; then
      printf '%s' "$STACK_OPENSEARCH_CONFIG_B64" | base64 --decode | sha256sum | awk '{ print $1 }'
    else
      sha256sum -- "$config_source" | awk '{ print $1 }'
    fi
    printf 'config/opensearch/docker-entrypoint.sh '
    if [[ -n "${STACK_OPENSEARCH_ENTRYPOINT_B64:-}" ]]; then
      printf '%s' "$STACK_OPENSEARCH_ENTRYPOINT_B64" | base64 --decode | sha256sum | awk '{ print $1 }'
    else
      sha256sum -- "$wrapper_source" | awk '{ print $1 }'
    fi
  } >>"$STACK_FAKE_CONTENT_LOG"
fi
if [[ -n "${STACK_FAKE_SWAP_RELEASE:-}" && ! -e "${STACK_FAKE_SWAP_MARKER:-}" ]]; then
  mv -- "$STACK_FAKE_SWAP_RELEASE" "$STACK_FAKE_SWAP_RELEASE.verified"
  mkdir -p -- "$STACK_FAKE_SWAP_RELEASE/scripts/remote"
  cat >"$STACK_FAKE_SWAP_RELEASE/scripts/remote/compose.sh" <<'SCRIPT'
#!/usr/bin/env bash
: >"$STACK_FAKE_TAMPER_MARKER"
exit 97
SCRIPT
  chmod 0755 -- "$STACK_FAKE_SWAP_RELEASE/scripts/remote/compose.sh"
  : >"$STACK_FAKE_SWAP_MARKER"
fi
if [[ "$joined" == *" --config - "* ]]; then
  cat >/dev/null
fi
case "${STACK_FAKE_FAIL_COMMAND:-}" in
  version)
    [[ "$joined" == *" compose version "* ]] && exit 40
    ;;
  config)
    [[ "$joined" == *" config "* ]] && exit 41
    ;;
  pull)
    [[ "$joined" == *" pull "* ]] && exit 42
    ;;
  up)
    [[ "$joined" == *" up "* ]] && exit 43
    ;;
  ps)
    [[ "$joined" == *" ps "* ]] && exit 44
    ;;
esac

if [[ "$joined" == *" config "* && "$joined" == *" --format json "* ]]; then
  if [[ -n "${STACK_FAKE_CONFIG_JSON:-}" ]]; then
    printf '%s\n' "$STACK_FAKE_CONFIG_JSON"
  else
    cat <<'JSON'
{"services":{"app-postgres":{"mem_limit":1073741824},"app-redis":{"mem_limit":536870912},"chroma":{"mem_limit":4294967296},"chroma-admin":{"mem_limit":536870912},"dynamodb-local":{"mem_limit":1073741824},"dynamodb-admin":{"mem_limit":536870912},"ollama-llm":{"mem_limit":15032385536},"ollama-embedding":{"mem_limit":2147483648},"opensearch":{"mem_limit":6442450944},"opensearch-dashboards":{"mem_limit":1073741824},"langfuse-postgres":{"mem_limit":2147483648},"langfuse-redis":{"mem_limit":536870912},"clickhouse":{"mem_limit":6442450944},"minio":{"mem_limit":1073741824},"langfuse-worker":{"mem_limit":2147483648},"langfuse-web":{"mem_limit":2147483648},"pgadmin":{"mem_limit":536870912},"redisinsight":{"mem_limit":536870912}}}
JSON
  fi
  exit 0
fi

if [[ "$joined" == *" config "* && -n "${STACK_FAKE_HOLD_SECONDS:-}" ]]; then
  sleep "$STACK_FAKE_HOLD_SECONDS"
fi

if [[ "$joined" == *" ps "* && "$joined" == *" --format json "* ]]; then
  if [[ "$joined" == *" --all "* && -n "${STACK_FAKE_PS_ALL_JSON:-}" ]]; then
    printf '%s\n' "$STACK_FAKE_PS_ALL_JSON"
  elif [[ -n "${STACK_FAKE_PS_JSON:-}" ]]; then
    printf '%s\n' "$STACK_FAKE_PS_JSON"
  else
    cat <<'JSON'
[{"Service":"app-postgres","State":"running","Health":"healthy"},{"Service":"app-redis","State":"running","Health":"healthy"},{"Service":"chroma","State":"running","Health":"healthy"},{"Service":"chroma-admin","State":"running","Health":"healthy"},{"Service":"dynamodb-local","State":"running","Health":"healthy"},{"Service":"dynamodb-admin","State":"running","Health":"healthy"},{"Service":"ollama-llm","State":"running","Health":"healthy"},{"Service":"ollama-embedding","State":"running","Health":"healthy"},{"Service":"opensearch","State":"running","Health":"healthy"},{"Service":"opensearch-dashboards","State":"running","Health":"healthy"},{"Service":"langfuse-postgres","State":"running","Health":"healthy"},{"Service":"langfuse-redis","State":"running","Health":"healthy"},{"Service":"clickhouse","State":"running","Health":"healthy"},{"Service":"minio","State":"running","Health":"healthy"},{"Service":"langfuse-worker","State":"running","Health":"healthy"},{"Service":"langfuse-web","State":"running","Health":"healthy"},{"Service":"pgadmin","State":"running","Health":"healthy"},{"Service":"redisinsight","State":"running","Health":"healthy"}]
JSON
  fi
fi

if [[ "$joined" == *" ps --quiet ollama-llm "* ]]; then
  printf '%s\n' container-ollama-llm
elif [[ "$joined" == *" ps --quiet ollama-embedding "* ]]; then
  printf '%s\n' container-ollama-embedding
fi
