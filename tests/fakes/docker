#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${STACK_DOCKER_LOG:-}" ]]; then
  {
    printf 'docker'
    printf ' %q' "$@"
    printf '\n'
  } >>"$STACK_DOCKER_LOG"
fi

joined=" $* "
if [[ -n "${STACK_FAKE_REQUIRE_OPENSEARCH_B64:-}" && "$joined" == *" config "* ]]; then
  [[ -n "${STACK_OPENSEARCH_CONFIG_B64:-}" && -n "${STACK_OPENSEARCH_ENTRYPOINT_B64:-}" ]] || exit 61
fi
project_directory=
compose_file=
versions_file=
arguments=("$@")
for ((index = 0; index < ${#arguments[@]}; index++)); do
  if [[ "${arguments[$index]}" == --project-directory && $((index + 1)) -lt ${#arguments[@]} ]]; then
    project_directory=${arguments[$((index + 1))]}
  elif [[ "${arguments[$index]}" == --file && $((index + 1)) -lt ${#arguments[@]} ]]; then
    compose_file=${arguments[$((index + 1))]}
  elif [[ "${arguments[$index]}" == --env-file && -z "$versions_file" && $((index + 1)) -lt ${#arguments[@]} ]]; then
    versions_file=${arguments[$((index + 1))]}
  fi
done
if [[ -n "${STACK_FAKE_RENDER_LOG:-}" && "$joined" == *" config "* ]]; then
  printf '%s\n' "$project_directory" >>"$STACK_FAKE_RENDER_LOG"
fi
if [[ -n "${STACK_FAKE_CONTENT_LOG:-}" && "$joined" == *" config "* ]]; then
  config_source=$project_directory/config/opensearch/opensearch.yml
  wrapper_source=$project_directory/config/opensearch/docker-entrypoint.sh
  {
    printf 'compose.yaml '
    sha256sum -- "$compose_file" | awk '{ print $1 }'
    printf 'versions.env '
    sha256sum -- "$versions_file" | awk '{ print $1 }'
    printf 'config/opensearch/opensearch.yml '
    if [[ -n "${STACK_OPENSEARCH_CONFIG_B64:-}" ]]; then
      printf '%s' "$STACK_OPENSEARCH_CONFIG_B64" | base64 --decode | sha256sum | awk '{ print $1 }'
    else
      sha256sum -- "$config_source" | awk '{ print $1 }'
    fi
    printf 'config/opensearch/docker-entrypoint.sh '
    if [[ -n "${STACK_OPENSEARCH_ENTRYPOINT_B64:-}" ]]; then
      printf '%s' "$STACK_OPENSEARCH_ENTRYPOINT_B64" | base64 --decode | sha256sum | awk '{ print $1 }'
    else
      sha256sum -- "$wrapper_source" | awk '{ print $1 }'
    fi
  } >>"$STACK_FAKE_CONTENT_LOG"
fi
if [[ -n "${STACK_FAKE_SWAP_RELEASE:-}" && ! -e "${STACK_FAKE_SWAP_MARKER:-}" ]]; then
  mv -- "$STACK_FAKE_SWAP_RELEASE" "$STACK_FAKE_SWAP_RELEASE.verified"
  mkdir -p -- "$STACK_FAKE_SWAP_RELEASE/scripts/remote"
  cat >"$STACK_FAKE_SWAP_RELEASE/scripts/remote/compose.sh" <<'SCRIPT'
#!/usr/bin/env bash
: >"$STACK_FAKE_TAMPER_MARKER"
exit 97
SCRIPT
  chmod 0755 -- "$STACK_FAKE_SWAP_RELEASE/scripts/remote/compose.sh"
  : >"$STACK_FAKE_SWAP_MARKER"
fi
if [[ "$joined" == *" --config - "* ]]; then
  cat >/dev/null
fi
case "${STACK_FAKE_FAIL_COMMAND:-}" in
  version)
    [[ "$joined" == *" compose version "* ]] && exit 40
    ;;
  config)
    [[ "$joined" == *" config "* ]] && exit 41
    ;;
  pull)
    [[ "$joined" == *" pull "* ]] && exit 42
    ;;
  up)
    [[ "$joined" == *" up "* ]] && exit 43
    ;;
  ps)
    [[ "$joined" == *" ps "* ]] && exit 44
    ;;
esac

if [[ "$joined" == *" config "* && "$joined" == *" --format json "* ]]; then
  if [[ -n "${STACK_FAKE_CONFIG_JSON:-}" ]]; then
    printf '%s\n' "$STACK_FAKE_CONFIG_JSON"
  else
    cat <<'JSON'
{"services":{"app-postgres":{"mem_limit":1073741824},"app-redis":{"mem_limit":536870912},"chroma":{"mem_limit":4294967296},"opensearch":{"mem_limit":6442450944},"opensearch-dashboards":{"mem_limit":1073741824},"langfuse-postgres":{"mem_limit":2147483648},"langfuse-redis":{"mem_limit":536870912},"clickhouse":{"mem_limit":6442450944},"minio":{"mem_limit":1073741824},"langfuse-worker":{"mem_limit":2147483648},"langfuse-web":{"mem_limit":2147483648},"pgadmin":{"mem_limit":536870912},"redisinsight":{"mem_limit":536870912}}}
JSON
  fi
  exit 0
fi

if [[ "$joined" == *" config "* && -n "${STACK_FAKE_HOLD_SECONDS:-}" ]]; then
  sleep "$STACK_FAKE_HOLD_SECONDS"
fi

if [[ "$joined" == *" ps "* && "$joined" == *" --format json "* ]]; then
  if [[ "$joined" == *" --all "* && -n "${STACK_FAKE_PS_ALL_JSON:-}" ]]; then
    printf '%s\n' "$STACK_FAKE_PS_ALL_JSON"
  elif [[ -n "${STACK_FAKE_PS_JSON:-}" ]]; then
    printf '%s\n' "$STACK_FAKE_PS_JSON"
  else
    cat <<'JSON'
[{"Service":"app-postgres","State":"running","Health":"healthy"},{"Service":"app-redis","State":"running","Health":"healthy"},{"Service":"chroma","State":"running","Health":"healthy"},{"Service":"opensearch","State":"running","Health":"healthy"},{"Service":"opensearch-dashboards","State":"running","Health":"healthy"},{"Service":"langfuse-postgres","State":"running","Health":"healthy"},{"Service":"langfuse-redis","State":"running","Health":"healthy"},{"Service":"clickhouse","State":"running","Health":"healthy"},{"Service":"minio","State":"running","Health":"healthy"},{"Service":"langfuse-worker","State":"running","Health":"healthy"},{"Service":"langfuse-web","State":"running","Health":"healthy"},{"Service":"pgadmin","State":"running","Health":"healthy"},{"Service":"redisinsight","State":"running","Health":"healthy"}]
JSON
  fi
fi
